# Sanaga for Arch Linux, Manjaro, EndeavourOS, Omarchy… (AUR)
# The video codecs YouTube & co. need come in as dependencies: nothing to
# install by hand.
pkgname=sanaga
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, light web browser built on WebKitGTK: containers, network ad blocker, per-site settings, mobile simulator"
arch=('x86_64' 'aarch64')
url="https://github.com/grassfieldhq/sanaga"
license=('MIT')
depends=(
  'gtk4'
  'webkitgtk-6.0'
  'hicolor-icon-theme'
  # video and audio: H.264 / AAC (gst-libav), AV1 / Opus parser (bad), VP9 (good)
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-libav'
  # passwords in the system keyring
  'libsecret'
)
optdepends=(
  'gst-plugin-va: video decoded by the graphics card (smoother, less battery)'
  'ffmpeg: video recording of the mobile simulator'
  'chromium: Netflix, Disney+, Spotify web (Widevine) opened from Sanaga'
  'spotify-launcher: open.spotify.com opened in the Spotify app'
)
makedepends=('cargo' 'git')
source=("git+https://github.com/grassfieldhq/sanaga.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/sanaga"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/sanaga"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$srcdir/sanaga"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$srcdir/sanaga"
  install -Dm755 target/release/sanaga "$pkgdir/usr/bin/sanaga"
  install -Dm644 packaging/sanaga.desktop "$pkgdir/usr/share/applications/sanaga.desktop"
  install -Dm644 packaging/sanaga.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sanaga.svg"
  for s in 48 64 128 256 512; do
    install -dm755 "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps"
    target/release/sanaga --export-icon "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/sanaga.png" "$s"
  done
  install -Dm644 packaging/site.grassfield.Sanaga.metainfo.xml "$pkgdir/usr/share/metainfo/site.grassfield.Sanaga.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
